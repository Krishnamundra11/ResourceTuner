# Copy to .env (gitignored) and fill in. Never commit real keys.
GOOGLE_API_KEY=          # Gemini, for the ADK agents (Supervisor / Decision / Meta)
OPENROUTER_API_KEY=      # OpenRouter, for the CrewAI diagnostic agents (free models first)
GROQ_API_KEY=            # Groq (openai/gpt-oss-120b): second layer for both ADK and CrewAI chains
# Optional local fallback, used only when an API call fails (degraded mode):
OLLAMA_BASE_URL=http://127.0.0.1:11434
