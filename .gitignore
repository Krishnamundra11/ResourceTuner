# ==============================================================================
# ResourceTuner .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Secrets & Environment Variables (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.production
!.env.example

# ------------------------------------------------------------------------------
# 2. Virtual Environments
# ------------------------------------------------------------------------------
venv/
venv-*/
.venv/
env/
ENV/
build/
dist/
*.egg-info/

# ------------------------------------------------------------------------------
# 3. Python Bytecode & Runtime Cache
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# ------------------------------------------------------------------------------
# 4. Testing, Linting & Coverage
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/

# ------------------------------------------------------------------------------
# 5. Runtime Databases, Logs & Artifacts
# ------------------------------------------------------------------------------
# Ignore all runtime databases and data logs, but preserve the data directory
data/*
!data/.gitkeep
*.db
*.db-journal
*.sqlite
*.sqlite3
*.log
*.jsonl

# ------------------------------------------------------------------------------
# 6. IDEs & Editor Metadata
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------------------------
# 7. Node.js / Frontend (frontend/ has its own .gitignore for its build output and
#    Playwright artifacts; this is a repo-wide safety net in case node_modules ever
#    appears somewhere else)
# ------------------------------------------------------------------------------
node_modules/
*.tsbuildinfo

# Built SPA (the output of `cd frontend && npm run build`). Not committed: it is
# regenerated on every build with new content-hashed filenames, so committing it would
# make every rebuild look like a full-file rewrite. Run the build once locally for
# resourcetuner/dashboard/main.py's /ui/ route to work — see README.md.
resourcetuner/dashboard/static/app/

# ------------------------------------------------------------------------------
# 8. OS Generated Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
